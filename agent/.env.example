# Скопируй этот файл в .env и впиши свои значения.
# .env в git не попадает (корневой .gitignore).
# ВНИМАНИЕ: этот файл коммитится. Ключей здесь быть не должно.

# --- Ключ RouterAI ----------------------------------------------------------
# Ключ с платформы RouterAI. Это НЕ OpenRouter: другой хост и другой ключ.
ROUTERAI_API_KEY=

# --- Модель -----------------------------------------------------------------
# Точный ID из каталога https://routerai.ru/api/v1/models
# Формат: провайдер/модель, например:
#   deepseek/deepseek-v4.1-flash-1017
#   deepseek/deepseek-v4-pro-0813
MODEL=

# --- Адрес API --------------------------------------------------------------
# RouterAI — OpenAI-совместимый API.
BASE_URL=https://routerai.ru/api/v1

# --- Агентный цикл ----------------------------------------------------------
# Предел шагов (для эксперимента 6.4 поставь 2)
MAX_STEPS=6
